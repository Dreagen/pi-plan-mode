{
    "name": "pi-plan-mode",
    "version": "0.1.0",
    "description": "Explicit planning mode for pi: guards agent operations outside configured planning directories.",
    "type": "module",
    "keywords": [
        "pi-package"
    ],
    "pi": {
        "extensions": [
            "./src/index.ts"
        ]
    },
    "scripts": {
        "test": "tsx --test test/*.test.ts",
        "typecheck": "tsc --noEmit",
        "smoke": "node scripts/rpc-smoke.mjs"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0"
    }
}
